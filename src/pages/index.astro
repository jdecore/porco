---
import CardsFeed from '../components/porco/CardsFeed.vue';
import CiteModal from '../components/porco/CiteModal.vue';
import FeedbackForm from '../components/porco/FeedbackForm.vue';
import riesgos from '../data/porco/riesgos_sanitarios.json';
import 'vue-data-ui/style.css';
import '../styles/porco.css';

const baseUrl = import.meta.env.BASE_URL || '/';
const withBase = (ruta: string) => `${baseUrl}${String(ruta).replace(/^\/+/, '')}`;
const site = Astro.site ?? new URL('https://porco-tau.vercel.app');
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const siteUrl = new URL(withBase('/'), site).toString().replace(/\/$/, '');
const claudeUrl = "https://claude.ai/new?modal=add-custom-connector&connectorName=" + encodeURIComponent("Porco | Observatorio sanitario porcino") + "&connectorUrl=" + encodeURIComponent(siteUrl + "/api/mcp") + "#settings/customize-connectors";

const fecha = new Intl.DateTimeFormat('es-CO', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${riesgos.meta.actualizado}T00:00:00Z`));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta
      name="description"
      content="Porco es un observatorio visual de evidencia y calidad de datos sanitarios porcinos en Colombia y la Región Andina: cisticercosis, PPA y trazabilidad para la era de la IA."
    />
    <meta name="author" content="Juan Enríquez" />
    <meta name="theme-color" content="#F2EEE7" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content="Porco | Observatorio de datos sanitarios" />
    <meta
      property="og:description"
      content="Seis señales para auditar lo que los datos agropecuarios y de salud pública en Colombia no están viendo."
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Porco" />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Porco | Observatorio de datos sanitarios" />
    <meta
      name="twitter:description"
      content="Cisticercosis, PPA, AnalítICA y la brecha de datos entre Colombia y la Región Andina."
    />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Porco",
        "url": "https://porco-tau.vercel.app",
        "description": "Observatorio de evidencia, trazabilidad y calidad de datos sanitarios porcinos.",
        "publisher": {
          "@type": "Organization",
          "name": "Porco",
          "url": "https://porco-tau.vercel.app"
        }
      }
    </script>

    <title>Porco | Sin datos ordenados ni limpios, la IA no ve nada</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="contenedor">
      <header class="topbar">
        <a class="brand" href={withBase('/')} aria-label="Porco, inicio">
          <span class="brand__mark" aria-hidden="true">
            <img src={withBase('logo.svg')} alt='' width='44' height='44' />
          </span>
          <span class="brand__name">Porco</span>
        </a>

        <nav class="topnav" aria-label="Navegación principal">
          <a
            class="nav-cta"
            href={claudeUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Conectar Porco a Claude por MCP"
          >Conectar con Claude</a>
          <a
            class="lang-toggle"
            href={withBase('en')}
            aria-label="Switch to English"
          >EN</a>
        </nav>
      </header>

      <!-- HERO CONTEXTO DE DATOS EN LA ERA DE LA IA -->
      <section class="hero">
        <p class="eyebrow">Auditoría · Evidencia · Colombia v0.0.1 pública</p>
        <h1 class="hero__title">
          Sin datos ordenados ni limpios,<br />
          <span>la IA no ve nada.</span>
        </h1>
        <p class="hero__lede">
          En la era de la IA, sin datos curados no hay modelos de inteligencia artificial que den buenos resultados y no alucinen. Seis señales sobre vacíos de información en Colombia antes de expandirlo a la Región Andina.
        </p>

        <div class="hero__stats">
          <div class="stat">
            <div class="stat__head">
              <strong>241</strong>
              <button
                type="button"
                class="cite-tag"
                aria-label="Ver cita ICA"
                data-trigger-cite="10"
              >
                ICA
              </button>
            </div>
            <span>Episodios AnalítICA 2026 (85% descartado PPC)</span>
          </div>

          <div class="stat">
            <div class="stat__head">
              <strong>78.4%</strong>
            </div>
            <span>Predios porcinos en traspatio informal (sin vigilancia activa)</span>
          </div>

          <div class="stat stat--alert">
            <div class="stat__head">
              <strong>4 años</strong>
            </div>
            <span>Desfase temporal en datos RIPS de MinSalud (congelado en 2021)</span>
          </div>

          <div class="stat stat--mono">
            <strong>v0.0.1 pública</strong>
            <span>actualizado {fecha}</span>
          </div>
        </div>
      </section>

      <!-- FEED DE 6 CARDS -->
      <CardsFeed
        client:visible
        tarjetas={riesgos.tarjetas_feed}
      />

      <footer class="site-footer">
        <div class="footer__brand">
          <span class="brand__name">Porco</span>
          <p>Observatorio de evidencia y calidad de datos para decisiones públicas y modelos de IA.</p>
        </div>

        <div class="footer__links">
          <a href={withBase('conectar')}>Conectar MCP</a>
          <a href={withBase('citas')}>Citas IEEE</a>
          <a href={withBase('data/colombia-andina-sanidad.csv')} download="colombia-andina-sanidad.csv">Descargar CSV</a>
          <a href={withBase('llms.txt')}>llms.txt</a>
          <a href={withBase('data/riesgos_sanitarios.json')}>JSON</a>
          <a href={withBase('api/mcp')}>API MCP</a>
          <button type="button" data-feedback-open>Comentarios</button>
        </div>

        <p class="footer__note">
          Fuentes y limitaciones: ICA (AnalítICA 2026 y Censo Pecuario), MinSalud (RIPS datos.gov.co), OMSA / WAHIS (Zonificación PPC/PPA), Eurostat (UE, 2025), USDA NASS (EE. UU., 2026), y estudios locales de Córdoba y Tolima para cisticercosis. Los datos administrativos miden atenciones, no pacientes; las muestras comunitarias describen entornos locales, no al país entero. Un dato no registrado no equivale a ausencia de enfermedad.
        </p>

        <div class="footer__citas-link-box">
          <a href={withBase('citas')} class="footer__citas-anchor">
            <span>Explorar catálogo completo de citas IEEE y metodología detallada</span>
            <span class="footer__citas-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </footer>
    </main>

    <CiteModal client:load />
    <FeedbackForm client:load />

    <script is:inline>
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const trigger = target.closest('[data-trigger-cite]');
        if (trigger) {
          const id = Number(trigger.getAttribute('data-trigger-cite'));
          if (id) {
            window.dispatchEvent(new CustomEvent('porco:abrir-cita', { detail: { id } }));
          }
        }
      });
    </script>
  </body>
</html>
