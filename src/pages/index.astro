---
import CardProblema from '../components/porco/CardProblema.vue';
import CardAmenaza from '../components/porco/CardAmenaza.vue';
import CardAccion from '../components/porco/CardAccion.vue';
import CardDesarrolladores from '../components/porco/CardDesarrolladores.vue';
import FeedbackForm from '../components/porco/FeedbackForm.vue';
import riesgos from '../data/porco/riesgos_sanitarios.json';
import 'vue-data-ui/style.css';
import '../styles/porco.css';

const baseUrl = import.meta.env.BASE_URL || '/';
const withBase = (ruta: string) => `${baseUrl}${String(ruta).replace(/^\/+/, '')}`;
const site = Astro.site ?? new URL('https://porco-tau.vercel.app');
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const siteUrl = new URL(withBase('/'), site).toString().replace(/\/$/, '');

const tarjeta = (id: string) => {
  const encontrada = riesgos.tarjetas.find((item) => item.id === id) as
    | {
        id: string;
        titulo: string;
        microcopy: string;
        prompt: string;
        comando: string;
      }
    | undefined;
  if (!encontrada) throw new Error(`Falta la tarjeta ${id} en riesgos_sanitarios.json`);
  return encontrada;
};

const problema = tarjeta('problema');
const amenaza = tarjeta('amenaza');
const accion = tarjeta('accion');
const desarrolladores = tarjeta('desarrolladores');

const fecha = new Intl.DateTimeFormat('es-CO', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${riesgos.meta.actualizado}T00:00:00Z`));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta
      name="description"
      content="Porco es un observatorio visual de riesgos sanitarios en LatAm: cisticercosis, PPA y la brecha de datos entre Colombia, la UE-27 y EE.UU."
    />
    <meta name="author" content="Juan Enríquez" />
    <meta name="theme-color" content="#F2EEE7" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content="Porco | Observatorio de riesgos sanitarios" />
    <meta
      property="og:description"
      content="Cuatro tarjetas para ver lo que los datos agropecuarios de LatAm no están viendo."
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Porco" />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Porco | Observatorio de riesgos sanitarios" />
    <meta
      name="twitter:description"
      content="Cisticercosis, PPA y la brecha de datos entre Colombia, la UE-27 y EE.UU."
    />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Porco",
        "url": "https://porco-tau.vercel.app",
        "description": "Observatorio visual de riesgos sanitarios en LatAm con enfoque One Health.",
        "publisher": {
          "@type": "Organization",
          "name": "Porco",
          "url": "https://porco-tau.vercel.app"
        }
      }
    </script>

    <title>Porco | Observatorio de riesgos sanitarios en LatAm</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="contenedor">
      <header class="topbar">
        <a class="brand" href={withBase('/')} aria-label="Porco, inicio">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" role="img">
              <path d="M7 13c0-4 3.6-7 8.2-7 4.7 0 8.3 3 8.3 7v3.3c0 4.5-3.7 8.2-8.3 8.2S7 20.8 7 16.3V13Z" />
              <path class="brand__snout" d="M20.8 14.8h4.4v5.1h-4.4z" />
              <circle class="brand__eye" cx="17.6" cy="12.9" r="1.25" />
            </svg>
          </span>
          <span class="brand__name">Porco</span>
        </a>

        <nav class="topnav" aria-label="Navegación principal">
          <a href="#tarjetas">Datos</a>
          <a href={withBase('conectar')}>Conectar</a>
          <a href={withBase('llms.txt')}>llms.txt</a>
          <button type="button" class="nav-cta" data-feedback-open>Comentarios</button>
        </nav>
      </header>

      <section class="hero">
        <p class="eyebrow">One Health · LatAm · Observatorio</p>
        <h1 class="hero__title">
          La sanidad porcina,<br />
          <span>sin puntos ciegos.</span>
        </h1>
        <p class="hero__lede">
          Cuatro señales para conectar animales, datos y personas. Lo que no se mide también enferma.
        </p>

        <div class="hero__stats">
          <div class="stat">
            <strong>40</strong>
            <span>territorios LatAm</span>
          </div>
          <div class="stat">
            <strong>24</strong>
            <span>sin datos de PPA</span>
          </div>
          <div class="stat stat--alert">
            <strong>9.7%</strong>
            <span>cisticercosis</span>
          </div>
          <div class="stat stat--mono">
            <strong>v1.0</strong>
            <span>actualizado {fecha}</span>
          </div>
        </div>
      </section>

      <section class="grid" id="tarjetas" aria-label="Cuatro tarjetas de datos">
        <CardProblema
          client:visible
          inventario={riesgos.inventario}
          territorios={riesgos.acceso_datos.territorios_latam}
          desconocidos={riesgos.acceso_datos.riesgo_ppa_desconocido}
          microcopy={problema.microcopy}
        />

        <CardAmenaza
          client:visible
          prevalencia={riesgos.cisticercosis.prevalencia_cerdos_pct}
          resto={riesgos.cisticercosis.prevalencia_resto_pct}
          microcopy={amenaza.microcopy}
        />

        <CardAccion
          client:visible
          siteUrl={siteUrl}
          promptPlantilla={accion.prompt}
        />

        <CardDesarrolladores
          client:visible
          comando={desarrolladores.comando}
          siteUrl={siteUrl}
        />
      </section>

      <footer class="site-footer">
        <div class="footer__brand">
          <span class="brand__name">Porco</span>
          <p>Observatorio de riesgos sanitarios. Datos abiertos para decisiones públicas.</p>
        </div>

        <div class="footer__links">
          <a href={withBase('conectar')}>Conectar MCP</a>
          <a href={withBase('llms.txt')}>llms.txt</a>
          <a href={withBase('data/riesgos_sanitarios.json')}>JSON</a>
          <a href={withBase('api/mcp')}>API MCP</a>
          <button type="button" data-feedback-open>Comentarios</button>
        </div>

        <p class="footer__note">
          Fuentes: Eurostat, USDA NASS, Porcinews y estudios de Córdoba y Tolima. Hecho por Juan Enríquez.
        </p>
      </footer>
    </main>

    <FeedbackForm client:load />
  </body>
</html>
